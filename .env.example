ENV=dev
HOST=127.0.0.1

API_BASE_URL=
FRONTEND_URL=https://localhost:3000

DJANGO_ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=django-insecure-123456789
DJANGO_SENTRY_DSN=

# Django database config
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=project_name
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_STORAGE_BUCKET_NAME=
AWS_QUERYSTRING_EXPIRE=

# Postgres config. should be same as Django database config above
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=project_name

# Let's Encrypt SSL Configuration
DOMAIN_NAMES=stage.project_name.com,www.stage.project_name.com
CERTBOT_EMAIL=admin@project_name.com

# used in lets init scripts
DOMAINS=(stage.project_name.com www.stage.project_name.com)

### Docker Flower config. Remove if flower is not used in project
#FLOWER_USERNAME=project_name
#FLOWER_PASSWORD=password@123
#FLOWER_PORT=5555
#REDIS_DB=0
#FLOWER_USERNAME=project_name
#FLOWER_PASSWORD=complex_password

